// Test-only config: same D1 + assets as wrangler.jsonc, but no remote bindings.
// Artifacts and Email Sending have no local emulator, so tests inject an in-memory
// Artifacts fake via app.fetch(req, env) and never open a remote proxy session.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitorange-test",
  "main": "worker/src/index.ts",
  // The workerd bundled with @cloudflare/vitest-pool-workers@0.22 supports dates up to 2026-08-22.
  // Bump to match wrangler.jsonc once the pool ships a newer runtime.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitorange-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "LFS", "bucket_name": "gitorange-lfs-test" },
    { "binding": "ACTIONS_LOGS", "bucket_name": "gitorange-actions-logs-test" },
    {
      "binding": "ACTIONS_CACHE",
      "bucket_name": "gitorange-actions-cache-test",
    },
  ],
  // Live updates: the real hub, so tests can open a WebSocket and hear pings.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],
  // No Actions containers or Workflow here: tests inject a fake ACTIONS_RUN and drive the
  // executor directly with a fake runner.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "APP_NAME": "GitOrange",
    "FROM_EMAIL": "test@example.com",
    "BASE_URL": "http://test.local",
    "R2_ACCOUNT_ID": "0123456789abcdef0123456789abcdef",
    "LFS_BUCKET_NAME": "gitorange-lfs-test",
    "ACTIONS_CACHE_BUCKET_NAME": "gitorange-actions-cache-test",
    "RESOLVER_MODEL": "@cf/zai-org/glm-5.3",
    "AI_GATEWAY": "off",
    "SUMMARY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "REVIEW_MODEL": "@cf/zai-org/glm-5.3",
  },
}
