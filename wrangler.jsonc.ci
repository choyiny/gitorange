{
  // CI-only wrangler config. CI copies it to wrangler.jsonc so `yarn build` can run, and
  // `yarn cf-typegen` generates worker-configuration.d.ts from it so the tracked types
  // never contain a deployer's account or resource IDs. Placeholders only — not for deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitorange",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitorange-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitorange" }],
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "LFS", "bucket_name": "gitorange-lfs" },
    { "binding": "ACTIONS_LOGS", "bucket_name": "gitorange-actions-logs" },
    { "binding": "ACTIONS_CACHE", "bucket_name": "gitorange-actions-cache" }
  ],
  "containers": [
    {
      "class_name": "JobRunner",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "./actions/runner/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOB_RUNNER", "class_name": "JobRunner" },
      { "name": "ACTIONS_QUEUE", "class_name": "ActionsQueue" },
      { "name": "MERGE_RESOLVER", "class_name": "MergeResolver" },
      { "name": "AGENT_REVIEWER", "class_name": "AgentReviewer" },
      { "name": "LIVE", "class_name": "LiveHub" }
    ]
  },
  "exports": {
    "JobRunner": { "type": "durable-object", "storage": "sqlite" },
    "ActionsQueue": { "type": "durable-object", "storage": "sqlite" },
    "MergeResolver": { "type": "durable-object", "storage": "sqlite" },
    "AgentReviewer": { "type": "durable-object", "storage": "sqlite" },
    "LiveHub": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    { "name": "gitorange-actions-run", "binding": "ACTIONS_RUN", "class_name": "ActionsRun" },
    { "name": "gitorange-merge-resolution", "binding": "MERGE_RESOLUTION", "class_name": "MergeResolutionWorkflow" }
  ],
  // Daily housekeeping: deletes Actions runs past their retention (Site admin → Actions).
  "triggers": { "crons": ["17 4 * * *", "30 2 * * *"] },
  // Workers AI: AI conflict resolution (RESOLVER_MODEL) and reviewer agents' reviews (SUMMARY_MODEL
  // one-liners, Clef for which agents review, REVIEW_MODEL for each review, single pass or Pi).
  "ai": { "binding": "AI" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/*/*.git/*", "/*/*.git", "/mcp", "/.well-known/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_NAME": "GitOrange",
    "BASE_URL": "http://localhost:8080",
    "FROM_EMAIL": "noreply@example.com",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "LFS_BUCKET_NAME": "gitorange-lfs",
    "ACTIONS_CACHE_BUCKET_NAME": "gitorange-actions-cache",
    // Workers AI model that resolves merge conflicts (pi agent with file tools).
    "RESOLVER_MODEL": "@cf/zai-org/glm-5.3",
    "GITORANGE_INSTALLATION": "",
    "GITORANGE_VERSION": "",
    "AI_GATEWAY": "default",
    "SUMMARY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "REVIEW_MODEL": "@cf/zai-org/glm-5.3",
    // Usage & cost: this deployment's resources, so analytics are filtered to GitOrange.
    "WORKER_NAME": "gitorange",
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000000",
    "ACTIONS_LOGS_BUCKET_NAME": "gitorange-actions-logs",
    "ARTIFACTS_NAMESPACE": "gitorange",
    "ACTIONS_WORKFLOW_NAME": "gitorange-actions-run",
    "MERGE_RESOLUTION_WORKFLOW_NAME": "gitorange-merge-resolution",
    "JOB_RUNNER_NAMESPACE_ID": "",
    "MERGE_RESOLVER_NAMESPACE_ID": "",
    "AGENT_REVIEWER_NAMESPACE_ID": "",
    "LIVE_NAMESPACE_ID": ""
  }
}
