{
  // CI-only wrangler config. CI copies it to wrangler.jsonc so `yarn build` can run, and
  // `yarn cf-typegen` generates worker-configuration.d.ts from it so the tracked types
  // never contain a deployer's account or resource IDs. Placeholders only — not for deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitorange",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitorange-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitorange" }],
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "LFS", "bucket_name": "gitorange-lfs" },
    { "binding": "ACTIONS_LOGS", "bucket_name": "gitorange-actions-logs" }
  ],
  "containers": [
    {
      "class_name": "JobRunner",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "./actions/runner/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOB_RUNNER", "class_name": "JobRunner" },
      { "name": "MERGE_RESOLVER", "class_name": "MergeResolver" }
    ]
  },
  "exports": {
    "JobRunner": { "type": "durable-object", "storage": "sqlite" },
    "MergeResolver": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    { "name": "gitorange-actions-run", "binding": "ACTIONS_RUN", "class_name": "ActionsRun" },
    { "name": "gitorange-merge-resolution", "binding": "MERGE_RESOLUTION", "class_name": "MergeResolutionWorkflow" }
  ],
  // Workers AI: AI conflict resolution (the model is RESOLVER_MODEL).
  "ai": { "binding": "AI" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/*/*.git/*", "/*/*.git", "/mcp", "/.well-known/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_NAME": "GitOrange",
    "BASE_URL": "http://localhost:8080",
    "FROM_EMAIL": "noreply@example.com",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "LFS_BUCKET_NAME": "gitorange-lfs",
    // Workers AI model that resolves merge conflicts (pi agent with file tools).
    "RESOLVER_MODEL": "@cf/zai-org/glm-5.3"
  }
}
