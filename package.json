{
  "name": "gitorange",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p worker/tsconfig.json",
    "cf-typegen": "node scripts/cf-typegen.mjs",
    "auth:generate": "npx --yes @better-auth/cli@latest generate --config worker/src/auth/index.ts --output worker/src/db/auth.schema.ts -y",
    "auth:format": "prettier --write worker/src/db/auth.schema.ts",
    "auth:update": "yarn auth:generate && node scripts/fix-auth-schema.mjs && yarn auth:format",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:studio:dev": "drizzle-kit studio",
    "tail": "wrangler tail --format=pretty",
    "test": "vitest run --config worker/vitest.config.ts",
    "test:watch": "vitest --config worker/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@cloudflare/computer": "0.4.0",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@hono/swagger-ui": "^0.6",
    "@hono/zod-openapi": "^1.3",
    "@primer/css": "^21",
    "@primer/octicons-react": "^19.38.0",
    "@primer/primitives": "^10",
    "@tanstack/react-query": "^5",
    "agents": "0.26.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45",
    "highlight.js": "^11.12.0",
    "hono": "^4.12",
    "marked": "^18.0.14",
    "mermaid": "^11",
    "node-diff3": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30",
    "yaml": "^2.9",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react-swc": "^3",
    "drizzle-kit": "^0.31",
    "husky": "^9",
    "lint-staged": "^16",
    "prettier": "^3",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^4.1.0",
    "wrangler": "^4"
  },
  "resolutions": {
    "vite": "^7.3.6"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/choyiny/gitorange.git"
  }
}
