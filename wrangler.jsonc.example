{
  // Copy this file to wrangler.jsonc and fill in your values (or run /gitorange-onboarding in Claude Code).
  // wrangler.jsonc is gitignored so each deployer keeps their own account and resource IDs.
  //
  // The top level is your PRODUCTION worker (`yarn deploy`).
  // `env.dev` is what `yarn dev` runs locally: local D1, but Artifacts has no local emulator,
  // so dev talks to the real service in a separate namespace and never touches production repos.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitorange",
  "main": "worker/src/index.ts",
  "account_id": "<your-cloudflare-account-id>",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Uncomment to serve on your own domain (the zone must be on Cloudflare):
  // "routes": [{ "pattern": "git.yourdomain.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitorange-db",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  // Git storage. One Artifacts repo per GitOrange repository, all in this namespace.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitorange" }],
  // Invitation emails. FROM_EMAIL's domain must be onboarded to Cloudflare Email Sending:
  // https://dash.cloudflare.com/?to=/:account/email-service
  "send_email": [{ "name": "EMAIL" }],
  // Git LFS file contents. Clients upload/download directly via pre-signed URLs, which need an
  // R2 API token: `wrangler secret put R2_ACCESS_KEY_ID` and `wrangler secret put R2_SECRET_ACCESS_KEY`.
  "r2_buckets": [
    { "binding": "LFS", "bucket_name": "gitorange-lfs" },
    { "binding": "ACTIONS_LOGS", "bucket_name": "gitorange-actions-logs" }
  ],
  // GitOrange Actions. Each run is a Workflow; each job gets its own container, started by a
  // JobRunner Durable Object (scheduling policy "durable_object"), which picks the instance size
  // from the job's runs-on. Wrangler builds the runner image from actions/runner/Dockerfile on
  // deploy. Step logs go to R2. Remove these four entries to deploy without Actions.
  "containers": [
    {
      "class_name": "JobRunner",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "./actions/runner/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOB_RUNNER", "class_name": "JobRunner" },
      { "name": "MERGE_RESOLVER", "class_name": "MergeResolver" },
      { "name": "LIVE", "class_name": "LiveHub" }
    ]
  },
  "exports": {
    "JobRunner": { "type": "durable-object", "storage": "sqlite" },
    "MergeResolver": { "type": "durable-object", "storage": "sqlite" },
    "LiveHub": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    { "name": "gitorange-actions-run", "binding": "ACTIONS_RUN", "class_name": "ActionsRun" },
    { "name": "gitorange-merge-resolution", "binding": "MERGE_RESOLUTION", "class_name": "MergeResolutionWorkflow" }
  ],
  // Workers AI: AI conflict resolution (RESOLVER_MODEL) and auto-merge review (SUMMARY_MODEL,
  // REVIEW_MODEL, and the Clef model named in each repository's .gitorange/review.yml).
  "ai": { "binding": "AI" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // API, auth, the git smart-HTTP endpoint (/<owner>/<repo>.git/...), the MCP server, and OAuth
    // discovery (/.well-known/...) must reach the worker.
    "run_worker_first": ["/api/*", "/*/*.git/*", "/*/*.git", "/mcp", "/.well-known/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_NAME": "GitOrange",
    // Public URL of the instance; used in invite links and auth redirects.
    "BASE_URL": "https://<your-deployed-host>",
    "FROM_EMAIL": "noreply@<your-email-sending-domain>",
    // Where pre-signed LFS URLs point: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<LFS_BUCKET_NAME>
    "R2_ACCOUNT_ID": "<your-cloudflare-account-id>",
    "LFS_BUCKET_NAME": "gitorange-lfs",
    // Workers AI model that resolves merge conflicts (pi agent with file tools).
    "RESOLVER_MODEL": "@cf/zai-org/glm-5.3",
    "SUMMARY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "REVIEW_MODEL": "@cf/zai-org/glm-5.3"
  },
  // BETTER_AUTH_SECRET is a secret: `wrangler secret put BETTER_AUTH_SECRET` (prod) / .dev.vars (dev).

  "env": {
    "dev": {
      // Named envs do not inherit bindings; everything the worker needs is repeated here.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gitorange-db-dev",
          "database_id": "local",
          "migrations_dir": "migrations"
        }
      ],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitorange-dev", "remote": true }],
      "send_email": [{ "name": "EMAIL" }],
      "r2_buckets": [
        { "binding": "LFS", "bucket_name": "gitorange-lfs-dev", "remote": true },
        { "binding": "ACTIONS_LOGS", "bucket_name": "gitorange-actions-logs-dev" }
      ],
      // Actions jobs run in local Docker containers in dev (Docker must be running).
      "containers": [
        {
          "class_name": "JobRunner",
          "scheduling_policy": "durable_object",
          "images": { "runner": { "dockerfile": "./actions/runner/Dockerfile" } }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "JOB_RUNNER", "class_name": "JobRunner" },
          { "name": "MERGE_RESOLVER", "class_name": "MergeResolver" },
          { "name": "LIVE", "class_name": "LiveHub" }
        ]
      },
      "workflows": [
        { "name": "gitorange-actions-run-dev", "binding": "ACTIONS_RUN", "class_name": "ActionsRun" },
        { "name": "gitorange-merge-resolution-dev", "binding": "MERGE_RESOLUTION", "class_name": "MergeResolutionWorkflow" }
      ],
      // Workers AI has no local emulator either; dev calls the real service.
      "ai": { "binding": "AI", "remote": true },
      "vars": {
        "APP_NAME": "GitOrange",
        "BASE_URL": "http://localhost:8080",
        "FROM_EMAIL": "noreply@<your-email-sending-domain>",
        "R2_ACCOUNT_ID": "<your-cloudflare-account-id>",
        "LFS_BUCKET_NAME": "gitorange-lfs-dev",
        "RESOLVER_MODEL": "@cf/zai-org/glm-5.3",
        "SUMMARY_MODEL": "@cf/zai-org/glm-5.3-flash",
        "REVIEW_MODEL": "@cf/zai-org/glm-5.3"
      }
    }
  }
}
